{
  "id": "linux",
  "version": 1,
  "label": "Linux",
  "desc": "Linux の基本コマンド",
  "commands": [
    {
      "id": "linux-ls",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイル・ディレクトリを一覧表示する",
      "code": "ls -la",
      "note": "-h と併用するとサイズが読みやすい。-t で更新日時順に並ぶ",
      "tag": "ファイル操作",
      "kw": "list 一覧 ls ファイル ディレクトリ 表示",
      "b": {
        "cmd": "ls",
        "flags": [
          { "opt": "-l", "label": "詳細（権限・サイズ）を表示" },
          { "opt": "-a", "label": "隠しファイルも表示" },
          { "opt": "-h", "label": "サイズを読みやすい単位で" },
          { "opt": "-t", "label": "更新日時順に並べる" },
          { "opt": "-r", "label": "逆順に並べる" },
          { "opt": "-S", "label": "サイズ順に並べる" }
        ],
        "args": [{ "name": "パス", "ph": "." }]
      }
    },
    {
      "id": "linux-cd",
      "env": "Linux",
      "cat": "Linux",
      "title": "カレントディレクトリを移動する",
      "code": "cd [ディレクトリ]",
      "note": "cd - で直前のディレクトリに戻る。cd だけでホームへ",
      "tag": "ファイル操作",
      "kw": "cd 移動 ディレクトリ change directory カレント",
      "b": {
        "cmd": "cd",
        "flags": [],
        "args": [{ "name": "ディレクトリ", "ph": "~/path" }]
      }
    },
    {
      "id": "linux-mkdir",
      "env": "Linux",
      "cat": "Linux",
      "title": "ディレクトリを作成する",
      "code": "mkdir -p [ディレクトリ]",
      "note": "-p を付けると途中の親ディレクトリもまとめて作成",
      "tag": "ファイル操作",
      "kw": "mkdir 作成 ディレクトリ フォルダ make",
      "b": {
        "cmd": "mkdir",
        "flags": [
          { "opt": "-p", "label": "親ディレクトリも作成" },
          { "opt": "-v", "label": "作成したものを表示" }
        ],
        "args": [{ "name": "ディレクトリ", "ph": "a/b/c" }]
      }
    },
    {
      "id": "linux-rm",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイル・ディレクトリを削除する",
      "code": "rm -rf [対象]",
      "note": "-rf は取り返しがつかないので対象をよく確認してから実行",
      "tag": "ファイル操作",
      "kw": "rm 削除 remove ファイル ディレクトリ 消す",
      "b": {
        "cmd": "rm",
        "flags": [
          { "opt": "-r", "label": "ディレクトリごと再帰的に削除" },
          { "opt": "-f", "label": "確認せず強制削除" },
          { "opt": "-i", "label": "削除前に確認" },
          { "opt": "-v", "label": "削除内容を表示" }
        ],
        "args": [{ "name": "対象", "ph": "path" }]
      }
    },
    {
      "id": "linux-mv",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイルを移動・リネームする",
      "code": "mv [移動元] [移動先]",
      "note": "同じディレクトリ内で名前を変えるとリネームになる",
      "tag": "ファイル操作",
      "kw": "mv 移動 rename リネーム 名前 変更 move",
      "b": {
        "cmd": "mv",
        "flags": [
          { "opt": "-i", "label": "上書き前に確認" },
          { "opt": "-f", "label": "確認せず強制上書き" },
          { "opt": "-n", "label": "既存ファイルを上書きしない" },
          { "opt": "-v", "label": "経過を表示" }
        ],
        "args": [
          { "name": "移動元", "ph": "src" },
          { "name": "移動先", "ph": "dst" }
        ]
      }
    },
    {
      "id": "linux-cp",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイルを別の場所にコピーする",
      "code": "cp [コピー元] [コピー先]",
      "note": "-r でディレクトリごとコピー、-p で権限・タイムスタンプを保持",
      "tag": "ファイル操作",
      "kw": "copy コピー duplicate 複製 cp file",
      "b": {
        "cmd": "cp",
        "flags": [
          { "opt": "-r", "label": "ディレクトリごとコピー" },
          { "opt": "-p", "label": "権限・タイムスタンプを保持" },
          { "opt": "-v", "label": "経過を表示" },
          { "opt": "-i", "label": "上書き前に確認" }
        ],
        "args": [
          { "name": "コピー元", "ph": "src/" },
          { "name": "コピー先", "ph": "dst/" }
        ]
      }
    },
    {
      "id": "linux-touch",
      "env": "Linux",
      "cat": "Linux",
      "title": "空ファイルを作成・更新日時を変える",
      "code": "touch [ファイル]",
      "note": "既存ファイルなら更新日時だけ現在時刻に変わる",
      "tag": "ファイル操作",
      "kw": "touch 作成 空ファイル タイムスタンプ 更新",
      "b": {
        "cmd": "touch",
        "flags": [
          { "opt": "-a", "label": "アクセス時刻のみ更新" },
          { "opt": "-m", "label": "更新時刻のみ更新" },
          { "opt": "-c", "label": "ファイルを作成しない" }
        ],
        "args": [{ "name": "ファイル", "ph": "file.txt" }]
      }
    },
    {
      "id": "linux-ln",
      "env": "Linux",
      "cat": "Linux",
      "title": "シンボリックリンクを作成する",
      "code": "ln -s [リンク先] [リンク名]",
      "note": "-s を外すとハードリンクになる。リンク先は絶対パス推奨",
      "tag": "ファイル操作",
      "kw": "ln link リンク シンボリック symlink ショートカット",
      "b": {
        "cmd": "ln",
        "flags": [
          { "opt": "-s", "label": "シンボリックリンクを作成" },
          { "opt": "-f", "label": "既存を上書き" },
          { "opt": "-v", "label": "経過を表示" }
        ],
        "args": [
          { "name": "リンク先", "ph": "/path/to/target" },
          { "name": "リンク名", "ph": "link" }
        ]
      }
    },
    {
      "id": "linux-cat",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイルの中身を表示する",
      "code": "cat [ファイル]",
      "note": "複数ファイルを連結して表示できる。大きいファイルは less を推奨",
      "tag": "テキスト処理",
      "kw": "cat 表示 中身 連結 出力 ファイル",
      "b": {
        "cmd": "cat",
        "flags": [
          { "opt": "-n", "label": "行番号を表示" },
          { "opt": "-b", "label": "空行以外に行番号" },
          { "opt": "-A", "label": "制御文字も可視化" }
        ],
        "args": [{ "name": "ファイル", "ph": "file.txt" }]
      }
    },
    {
      "id": "linux-less",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイルをスクロールしながら閲覧する",
      "code": "less [ファイル]",
      "note": "/ で検索、q で終了。+F で tail -f のように追記を追える",
      "tag": "テキスト処理",
      "kw": "less 閲覧 ページャ スクロール 表示 ログ",
      "b": {
        "cmd": "less",
        "flags": [
          { "opt": "-N", "label": "行番号を表示" },
          { "opt": "-S", "label": "行を折り返さない" },
          { "opt": "+F", "label": "追記をリアルタイム追従" }
        ],
        "args": [{ "name": "ファイル", "ph": "app.log" }]
      }
    },
    {
      "id": "linux-head",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイルの先頭を表示する",
      "code": "head -n 20 [ファイル]",
      "note": "-c を使うとバイト数で先頭を取り出せる",
      "tag": "テキスト処理",
      "kw": "head 先頭 冒頭 表示 行数 ファイル",
      "b": {
        "cmd": "head",
        "flags": [
          { "opt": "-n", "label": "行数を指定" },
          { "opt": "-c", "label": "バイト数を指定" }
        ],
        "args": [{ "name": "ファイル", "ph": "file.txt" }]
      }
    },
    {
      "id": "linux-tail",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイルの末尾を表示・追従する",
      "code": "tail -f [ファイル]",
      "note": "-F ならログローテーション後も追従を継続する",
      "tag": "テキスト処理",
      "kw": "tail 末尾 追従 ログ リアルタイム follow",
      "b": {
        "cmd": "tail",
        "flags": [
          { "opt": "-f", "label": "追記をリアルタイム表示" },
          { "opt": "-F", "label": "ローテーションも追従" },
          { "opt": "-n", "label": "末尾の行数を指定" }
        ],
        "args": [{ "name": "ファイル", "ph": "app.log" }]
      }
    },
    {
      "id": "linux-grep",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイル内の文字列を検索する",
      "code": "grep -rn \"pattern\" ./",
      "note": "-r で再帰検索、-n で行番号表示、-i で大文字小文字を無視",
      "tag": "検索",
      "kw": "search 検索 find grep 文字列 探す",
      "b": {
        "cmd": "grep",
        "flags": [
          { "opt": "-r", "label": "再帰的に検索" },
          { "opt": "-n", "label": "行番号を表示" },
          { "opt": "-i", "label": "大文字小文字を無視" },
          { "opt": "-w", "label": "単語単位で一致" },
          { "opt": "-l", "label": "ファイル名のみ表示" }
        ],
        "args": [
          { "name": "パターン", "ph": "\"pattern\"" },
          { "name": "対象パス", "ph": "./" }
        ]
      }
    },
    {
      "id": "linux-find",
      "env": "Linux",
      "cat": "Linux",
      "title": "条件を指定してファイルを探す",
      "code": "find . -name \"*.log\"",
      "note": "-exec や -delete で見つけたファイルへ操作もできる",
      "tag": "検索",
      "kw": "find 検索 探す ファイル 名前 条件",
      "b": {
        "cmd": "find",
        "flags": [
          { "opt": "-name", "label": "名前パターンで検索" },
          { "opt": "-type", "label": "種類で絞る（f/d）" },
          { "opt": "-mtime", "label": "更新日で絞る" },
          { "opt": "-delete", "label": "見つけたら削除" }
        ],
        "args": [
          { "name": "検索パス", "ph": "." },
          { "name": "条件", "ph": "-name \"*.log\"" }
        ]
      }
    },
    {
      "id": "linux-wc",
      "env": "Linux",
      "cat": "Linux",
      "title": "行数・単語数・文字数を数える",
      "code": "wc -l [ファイル]",
      "note": "パイプで受け取ると出力の行数カウントに便利",
      "tag": "テキスト処理",
      "kw": "wc カウント 行数 単語数 文字数 数える",
      "b": {
        "cmd": "wc",
        "flags": [
          { "opt": "-l", "label": "行数を数える" },
          { "opt": "-w", "label": "単語数を数える" },
          { "opt": "-c", "label": "バイト数を数える" },
          { "opt": "-m", "label": "文字数を数える" }
        ],
        "args": [{ "name": "ファイル", "ph": "file.txt" }]
      }
    },
    {
      "id": "linux-sort",
      "env": "Linux",
      "cat": "Linux",
      "title": "行を並べ替える",
      "code": "sort [ファイル]",
      "note": "-u で重複を除きつつソート。uniq と組み合わせると集計に便利",
      "tag": "テキスト処理",
      "kw": "sort 並べ替え ソート 整列 順番",
      "b": {
        "cmd": "sort",
        "flags": [
          { "opt": "-n", "label": "数値として並べる" },
          { "opt": "-r", "label": "逆順に並べる" },
          { "opt": "-u", "label": "重複行を除く" },
          { "opt": "-k", "label": "並べ替えるキー列を指定" },
          { "opt": "-f", "label": "大文字小文字を無視" }
        ],
        "args": [{ "name": "ファイル", "ph": "file.txt" }]
      }
    },
    {
      "id": "linux-uniq",
      "env": "Linux",
      "cat": "Linux",
      "title": "連続する重複行をまとめる",
      "code": "sort [ファイル] | uniq -c",
      "note": "uniq は連続した重複しか見ないので先に sort するのが定石",
      "tag": "テキスト処理",
      "kw": "uniq 重複 集計 カウント 一意 ユニーク",
      "b": {
        "cmd": "uniq",
        "flags": [
          { "opt": "-c", "label": "各行の出現回数を付与" },
          { "opt": "-d", "label": "重複行のみ表示" },
          { "opt": "-u", "label": "一意な行のみ表示" },
          { "opt": "-i", "label": "大文字小文字を無視" }
        ],
        "args": [{ "name": "ファイル", "ph": "file.txt" }]
      }
    },
    {
      "id": "linux-chmod",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイルの権限を変更する",
      "code": "chmod 755 [対象]",
      "note": "数値は所有者/グループ/その他の rwx。u+x のような記号指定も可",
      "tag": "権限",
      "kw": "chmod 権限 パーミッション 実行 permission モード",
      "b": {
        "cmd": "chmod",
        "flags": [
          { "opt": "-R", "label": "ディレクトリ内も再帰的に適用" },
          { "opt": "-v", "label": "変更内容を表示" }
        ],
        "args": [
          { "name": "権限", "ph": "755" },
          { "name": "対象", "ph": "script.sh" }
        ]
      }
    },
    {
      "id": "linux-chown",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイルの所有者を変更する",
      "code": "chown user:group [対象]",
      "note": "多くの場合 sudo が必要。-R でディレクトリ配下もまとめて変更",
      "tag": "権限",
      "kw": "chown 所有者 オーナー グループ owner 変更",
      "b": {
        "cmd": "chown",
        "flags": [
          { "opt": "-R", "label": "ディレクトリ内も再帰的に適用" },
          { "opt": "-v", "label": "変更内容を表示" }
        ],
        "args": [
          { "name": "所有者", "ph": "user:group" },
          { "name": "対象", "ph": "file" }
        ]
      }
    },
    {
      "id": "linux-ps",
      "env": "Linux",
      "cat": "Linux",
      "title": "実行中のプロセスを一覧表示する",
      "code": "ps aux",
      "note": "grep と組み合わせて特定プロセスを探すことが多い",
      "tag": "プロセス",
      "kw": "ps プロセス 一覧 process 実行中 確認",
      "b": {
        "cmd": "ps",
        "flags": [
          { "opt": "a", "label": "全ユーザーのプロセス" },
          { "opt": "u", "label": "所有者やCPUなど詳細表示" },
          { "opt": "x", "label": "端末を持たないプロセスも含む" }
        ],
        "args": []
      }
    },
    {
      "id": "linux-kill",
      "env": "Linux",
      "cat": "Linux",
      "title": "プロセスを終了させる",
      "code": "kill -9 [PID]",
      "note": "-9 は強制終了。まずは -15（通常終了）を試すのが安全",
      "tag": "プロセス",
      "kw": "kill 終了 プロセス 停止 シグナル PID",
      "b": {
        "cmd": "kill",
        "flags": [
          { "opt": "-15", "label": "通常終了（SIGTERM）" },
          { "opt": "-9", "label": "強制終了（SIGKILL）" },
          { "opt": "-l", "label": "シグナル一覧を表示" }
        ],
        "args": [{ "name": "PID", "ph": "1234" }]
      }
    },
    {
      "id": "linux-top",
      "env": "Linux",
      "cat": "Linux",
      "title": "CPU・メモリ使用状況を監視する",
      "code": "top",
      "note": "見やすさ重視なら htop も便利。q で終了",
      "tag": "プロセス",
      "kw": "top 監視 CPU メモリ 負荷 モニタ",
      "b": {
        "cmd": "top",
        "flags": [
          { "opt": "-o", "label": "並び替えるキーを指定" },
          { "opt": "-d", "label": "更新間隔（秒）を指定" },
          { "opt": "-u", "label": "特定ユーザーで絞る" }
        ],
        "args": []
      }
    },
    {
      "id": "linux-df",
      "env": "Linux",
      "cat": "Linux",
      "title": "ディスクの空き容量を確認する",
      "code": "df -h",
      "note": "-h で GB/MB 表示。-i で inode の使用状況を確認できる",
      "tag": "ディスク",
      "kw": "df ディスク 容量 空き 使用量 ストレージ",
      "b": {
        "cmd": "df",
        "flags": [
          { "opt": "-h", "label": "読みやすい単位で表示" },
          { "opt": "-T", "label": "ファイルシステム種別を表示" },
          { "opt": "-i", "label": "inode 使用状況を表示" }
        ],
        "args": []
      }
    },
    {
      "id": "linux-du",
      "env": "Linux",
      "cat": "Linux",
      "title": "ディレクトリの使用容量を調べる",
      "code": "du -sh [対象]",
      "note": "-sh で対象全体の合計だけを読みやすく表示",
      "tag": "ディスク",
      "kw": "du 容量 使用量 サイズ ディレクトリ 調べる",
      "b": {
        "cmd": "du",
        "flags": [
          { "opt": "-s", "label": "合計のみ表示" },
          { "opt": "-h", "label": "読みやすい単位で表示" },
          { "opt": "-a", "label": "ファイルごとに表示" }
        ],
        "args": [{ "name": "対象", "ph": "." }]
      }
    },
    {
      "id": "linux-lsof",
      "env": "Linux",
      "cat": "Linux",
      "title": "ポートを使用中のプロセスを調べる",
      "code": "lsof -i :8080",
      "note": "netstat -tlnp でも可。kill [PID] で該当プロセスを停止",
      "tag": "ネットワーク",
      "kw": "port ポート process プロセス lsof network 使用中",
      "b": {
        "cmd": "lsof",
        "flags": [
          { "opt": "-i", "label": "ネットワーク接続を対象" },
          { "opt": "-P", "label": "ポート番号を数値表示" },
          { "opt": "-n", "label": "ホスト名を解決しない" }
        ],
        "args": [{ "name": "ポート", "ph": ":8080" }]
      }
    },
    {
      "id": "linux-tar",
      "env": "Linux",
      "cat": "Linux",
      "title": "ファイルをアーカイブ・圧縮する",
      "code": "tar -czf archive.tar.gz [対象]",
      "note": "展開は -xzf。-tzf で中身を一覧できる",
      "tag": "アーカイブ",
      "kw": "tar アーカイブ 圧縮 展開 gzip まとめる",
      "b": {
        "cmd": "tar",
        "flags": [
          { "opt": "-c", "label": "アーカイブを作成" },
          { "opt": "-x", "label": "アーカイブを展開" },
          { "opt": "-z", "label": "gzip で圧縮" },
          { "opt": "-f", "label": "ファイル名を指定" },
          { "opt": "-v", "label": "経過を表示" },
          { "opt": "-t", "label": "中身を一覧表示" }
        ],
        "args": [
          { "name": "アーカイブ名", "ph": "archive.tar.gz" },
          { "name": "対象", "ph": "dir/" }
        ]
      }
    },
    {
      "id": "linux-curl",
      "env": "Linux",
      "cat": "Linux",
      "title": "URL からデータを取得する",
      "code": "curl -O [URL]",
      "note": "-L でリダイレクトを追従。-I でヘッダのみ確認できる",
      "tag": "ネットワーク",
      "kw": "curl ダウンロード 取得 http api リクエスト",
      "b": {
        "cmd": "curl",
        "flags": [
          { "opt": "-O", "label": "URL のファイル名で保存" },
          { "opt": "-o", "label": "保存先を指定" },
          { "opt": "-L", "label": "リダイレクトを追従" },
          { "opt": "-s", "label": "進捗を隠す" },
