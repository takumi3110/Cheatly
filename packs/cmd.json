      "kw": "ip ネットワーク network ipconfig アドレス 確認",
      "b": {
        "cmd": "ipconfig",
        "flags": [
          { "opt": "/all", "label": "詳細をすべて表示" },
          { "opt": "/release", "label": "IPアドレスを解放" },
          { "opt": "/renew", "label": "IPアドレスを再取得" },
          { "opt": "/flushdns", "label": "DNSキャッシュを消去" }
        ],
        "args": []
      }
    }
